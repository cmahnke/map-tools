diff --git a/planetiler-dist/pom.xml b/planetiler-dist/pom.xml
index 5560cc4..3c50d2e 100644
--- a/planetiler-dist/pom.xml
+++ b/planetiler-dist/pom.xml
@@ -155,6 +155,50 @@
         <assembly-phase>none</assembly-phase>
       </properties>
     </profile>
+    <profile>
+      <!-- build the planetiler native image, requires a GraalVM JDK as JAVA_HOME:
+        ./mvnw package -Pnative -DskipTests
+        Native image configuration (reflection/resources/foreign downcalls) is bundled in
+        src/main/resources/META-INF/native-image and picked up automatically. -->
+      <id>native</id>
+      <build>
+        <plugins>
+          <plugin>
+            <groupId>org.graalvm.buildtools</groupId>
+            <artifactId>native-maven-plugin</artifactId>
+            <version>1.1.10</version>
+            <extensions>true</extensions>
+            <configuration>
+              <mainClass>${mainClass}</mainClass>
+              <imageName>planetiler</imageName>
+              <outputDirectory>${project.build.directory}/native-image</outputDirectory>
+              <buildArgs>
+                <arg>--no-fallback</arg>
+                <!-- madvise downcalls via the foreign function & memory api -->
+                <arg>--enable-native-access=ALL-UNNAMED</arg>
+                <!-- geotools registers custom java.util.logging levels during primordial
+                  logging initialization which would otherwise end up uninitialized in the
+                  image heap -->
+                <arg>--initialize-at-build-time=org.geotools.util.logging.Logging$LogLevel</arg>
+                <!-- hsqldb (used by gt-epsg-hsql for coordinate reference systems) hardcodes
+                  Locale.UK for date formatting -->
+                <arg>-H:IncludeLocales=en-GB</arg>
+              </buildArgs>
+              <requiredVersion>>=21</requiredVersion>
+            </configuration>
+            <executions>
+              <execution>
+                <id>build-native-image</id>
+                <goals>
+                  <goal>compile-no-fork</goal>
+                </goals>
+                <phase>package</phase>
+              </execution>
+            </executions>
+          </plugin>
+        </plugins>
+      </build>
+    </profile>
     <profile>
       <id>jib-multi-arch</id>
       <build>
